  "scenarios": [
    {"id": "A-DS-FIVEPOINTS", "name": "DS Five Points substation failure", "scenario_type": "power_failure",
     "description": "DS-2 Five Points (simulated) trips. Its three radial feeders lose supply; normally-open ties to Centennial, Capitol and Peachtree Center can only pick up part of the load, and the outage cascades into water pumping, telecom, signals and MARTA.",
     "fail_nodes": ["PWR-DS-FIVEPOINTS"], "focus_node_id": "PWR-DS-FIVEPOINTS"},
    {"id": "B-EDGEWOOD-DUCTBANK", "name": "Excavation strike on Edgewood Ave duct bank (Grady / Georgia State)", "scenario_type": "corridor_strike",
     "description": "A contractor strikes the shared Edgewood Ave duct bank between Courtland St and Jesse Hill Jr Dr. Every cable in the trench is cut at once: feeder GR-1 (one of Grady's two power feeds, plus the traction feed for Georgia State station) and the fibre backhaul of BOTH access nodes that give Grady its 'diverse' communications paths (common-cause failure).",
     "fail_edges": ["UGD-DB-06"], "focus_node_id": "corridor:UGD-DB-06"},
    {"id": "C-WATER-MAIN-DECATUR", "name": "Transmission main break on Decatur St", "scenario_type": "water_rupture",
     "description": "A transmission water main ruptures on Decatur St east of Five Points; crews must close isolation valves, cutting supply to part of the low-pressure grid.",
     "fail_edges_near": [{"connection_type": "water_main", "near": [33.7538, -84.3884]}], "focus_node_id": "WTR-JN-07"},
    {"id": "D-TELECOM-56MARIETTA", "name": "56 Marietta St carrier hotel outage", "scenario_type": "telecom_outage",
     "description": "The core interconnection facility at 56 Marietta St (real building; modelled connections simulated) goes dark. The dual-homed fibre rings fail over to the east core, but the Capitol Hill access node and the Five Points rooftop cell are backhauled only into 56 Marietta: City Hall and the Fulton County Courthouse lose communications.",
     "fail_nodes": ["TEL-IX-56MARIETTA"], "focus_node_id": "TEL-IX-56MARIETTA"},
    {"id": "E-ROADS-FIVEPOINTS", "name": "Five Points cordon (road closures)", "scenario_type": "road_disruption",
     "description": "An emergency cordon closes the Five Points intersection, the Marietta St / Broad St corner outside Five Points station and the adjoining blocks of Peachtree St, Marietta St and Edgewood Ave. Traffic detours around the core and Five Points station loses its street access.",
     "fail_intersections": [{"at": "Peachtree St & Edgewood Ave", "near": [33.7546, -84.3902]}, {"at": "Marietta St & Broad St", "near": [33.7552, -84.3913]}],
     "fail_road_legs": {"at": "Peachtree St & Edgewood Ave", "near": [33.7546, -84.3902], "streets": ["Peachtree St", "Marietta St", "Edgewood Ave"]}, "focus_node_id": "road:Peachtree St & Edgewood Ave"},
    {"id": "F-TS-SOUTH", "name": "Loss of TS-South bulk supply (overload cascade)", "scenario_type": "power_failure",
     "description": "The TS-South 115 kV bulk supply point (simulated) is lost. DS-2 Five Points shifts onto its alternate line from TS-West, which was never rated for the full load: it runs above its 120% emergency limit, trips in the next round, and Five Points blacks out - a true overload cascade.",
     "fail_nodes": ["PWR-TS-SOUTH"], "focus_node_id": "PWR-TS-SOUTH"}
  ],
  "demo": {
    "id": "deeptrace-atlanta-demo",
    "title": "DEEPTRACE: one substation, six systems",
    "focus_node_id": "PWR-DS-FIVEPOINTS",
    "scenario_a_preset": "A-DS-FIVEPOINTS",
    "scenario_b_preset": "B-EDGEWOOD-DUCTBANK",
    "steps": [
      {"id": "overview", "action": "overview", "title": "Downtown Atlanta as one living system",
       "narration": "This is downtown Atlanta — Five Points, Peachtree Center, the Capitol and Grady — rebuilt as a digital twin. Streets and landmarks are approximate; every utility asset beneath them is an illustrative simulation."},
      {"id": "deep_mode", "action": "deep_mode", "title": "Go beneath the street",
       "narration": "Deep mode peels the city open. Pipes, cables, duct banks and rail tunnels are drawn at modelled depth, so you can see what normally only shows up when someone digs."},
      {"id": "reveal_layers", "action": "reveal_layers", "title": "Six interdependent networks",
       "narration": "Power, water, internet, transportation, shared underground corridors and critical facilities. The thin links between them are dependencies: pumps need power, signals need power, switches need comms."},
      {"id": "select_node", "action": "select_node", "node_id": "PWR-DS-FIVEPOINTS", "title": "DS-2 Five Points (simulated)",
       "narration": "This simulated distribution substation feeds the heart of downtown through three radial feeders. Its inspector shows rating, load and provenance, labelled SIMULATED."},
