# ---------------------------------------------------------------------------
# DEEPTRACE configuration. Copy to `.env` (repo root) and fill in what you have.
# Everything is optional: without keys DEEPTRACE runs in a fully functional
# fallback mode (dark basemap, no 3D buildings, deterministic offline analyst).
# ---------------------------------------------------------------------------

# --- 3D world (browser) -----------------------------------------------------
# Cesium ion access token: streams Cesium OSM Buildings, Cesium World Terrain
# and ion imagery. Create a free token at https://ion.cesium.com/tokens
# (restrict it to your domain for public deployments). Exposed to the browser.
NEXT_PUBLIC_CESIUM_ION_TOKEN=

# Basemap: ion-aerial (default with a token) | carto-dark (default without) | osm | none
NEXT_PUBLIC_DEEPTRACE_BASEMAP=

# Backend URL used by the browser
NEXT_PUBLIC_DEEPTRACE_API_URL=http://localhost:8000

# --- Backend ----------------------------------------------------------------
# Region folder under backend/datasets/regions/
DEEPTRACE_REGION=atlanta-downtown
# Comma-separated origins allowed to call the API (localhost is always allowed)
DEEPTRACE_CORS_ORIGINS=http://localhost:3000

# --- AI analyst (Claude) ----------------------------------------------------
# Without a key the deterministic offline analyst answers (clearly labelled).
ANTHROPIC_API_KEY=
DEEPTRACE_LLM_PROVIDER=anthropic
DEEPTRACE_LLM_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max  (lower = faster answers)
DEEPTRACE_LLM_EFFORT=medium
DEEPTRACE_LLM_MAX_TOOL_ROUNDS=8

# --- Data ingestion (optional, needs open network access) ---------------------
DEEPTRACE_OVERPASS_URL=https://overpass-api.de/api/interpreter
